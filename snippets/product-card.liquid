{% doc %}
  Renders an editorial botanical product card.

  @param {product} product - The Shopify product object to render
  @param {string} [class] - Optional extra CSS class

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

<div class="botanical-product-card {{ class }}">
  <a href="{{ product.url }}" class="botanical-product-card__media">
    {% if product.featured_image %}
      {% render 'image',
        image: product.featured_image,
        url: product.url,
        class: 'botanical-product-card__image',
        width: 600,
        height: 750,
        crop: 'center'
      %}
    {% else %}
      <div class="botanical-product-card__placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" width="48" height="48">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S12 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S12 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582" />
        </svg>
      </div>
    {% endif %}

    {% if product.compare_at_price > product.price %}
      <span class="botanical-product-card__badge">{{ 'products.sale' | t }}</span>
    {% endif %}
  </a>

  <div class="botanical-product-card__info">
    {% if product.vendor != blank %}
      <span class="botanical-product-card__vendor">{{ product.vendor }}</span>
    {% endif %}

    <h3 class="botanical-product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="botanical-product-card__price">
      {% if product.price_varies %}
        <span class="botanical-product-card__price-prefix">{{ 'products.from' | t }}</span>
      {% endif %}
      <span class="botanical-product-card__price-regular">{{ product.price | money }}</span>

      {% if product.compare_at_price > product.price %}
        <s class="botanical-product-card__price-compare">{{ product.compare_at_price | money }}</s>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .botanical-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    background-color: var(--color-surface, #F4EFE6);
    border: 1px solid var(--color-border, #E6E1D6);
    border-radius: var(--style-border-radius-cards, 10px);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .botanical-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(35, 46, 36, 0.06);
  }

  .botanical-product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background-color: #EFEAE0;
    overflow: hidden;
    text-decoration: none;
  }

  .botanical-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--transition-timing, ease);
  }

  .botanical-product-card:hover .botanical-product-card__image img {
    transform: scale(1.04);
  }

  .botanical-product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary, #5B6E5D);
    opacity: 0.6;
  }

  .botanical-product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-primary, #263629);
    color: #FBF9F5;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    z-index: 2;
  }

  .botanical-product-card__info {
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.35rem;
  }

  .botanical-product-card__vendor {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary, #5B6E5D);
  }

  .botanical-product-card__title {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0.25rem 0;
  }

  .botanical-product-card__title a {
    text-decoration: none;
    color: var(--color-foreground, #232E24);
    transition: color 0.2s ease;
  }

  .botanical-product-card__title a:hover {
    color: var(--color-secondary, #5B6E5D);
  }

  .botanical-product-card__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .botanical-product-card__price-prefix {
    color: var(--color-secondary, #5B6E5D);
    font-size: 0.85rem;
  }

  .botanical-product-card__price-regular {
    color: var(--color-foreground, #232E24);
  }

  .botanical-product-card__price-compare {
    color: var(--color-secondary, #5B6E5D);
    font-size: 0.85rem;
  }
{% endstylesheet %}
