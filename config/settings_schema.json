[
  {
    "name": "theme_info",
    "theme_name": "Aryvan Botanical Wellness",
    "theme_version": "1.0.0",
    "theme_author": "Aryvan Botanical Wellness",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_garamond_n4",
        "label": "t:general.heading"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FBF9F5",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#232E24",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#263629",
        "label": "t:general.primary"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "default": "#5B6E5D",
        "label": "t:general.secondary"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#F4EFE6",
        "label": "t:general.surface"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#C49A6C",
        "label": "t:general.accent"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#E6E1D6",
        "label": "t:labels.border"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  }
