[
  {
    "name": "theme_info",
    "theme_name": "Aryvan Botanical Wellness",
    "theme_version": "2.0.0",
    "theme_author": "Aryvan Botanical Wellness",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_garamond_n4",
        "label": "t:general.heading"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F8F5EF",
        "label": "Warm Ivory Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#292D29",
        "label": "Charcoal Body Text"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#1F3025",
        "label": "Deep Forest Green"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "default": "#263B2D",
        "label": "Dark Botanical Green"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#F1EADF",
        "label": "Soft Cream Surface"
      },
      {
        "type": "color",
        "id": "color_sage",
        "default": "#A4AE98",
        "label": "Muted Sage"
      },
      {
        "type": "color",
        "id": "color_olive",
        "default": "#69775C",
        "label": "Olive Accent"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#C7A77A",
        "label": "Champagne Gold"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#E4DDD1",
        "label": "Subtle Border"
