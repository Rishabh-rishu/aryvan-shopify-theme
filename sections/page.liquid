{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<section class="page-section full-width">
  <div class="page-section__container">
    <div class="page-section__header">
      <span class="eyebrow">ARYVAN BOTANICAL</span>
      <h1 class="page-section__title">{{ page.title }}</h1>
    </div>

    <div class="page-section__content rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% stylesheet %}
  .page-section {
    padding: 4.5rem 0 7rem;
    background-color: var(--color-bg-primary, #0B1510);
    color: var(--color-text-primary, #F3EBDD);
    min-height: 60vh;
  }
  .page-section__container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }
  .page-section__header {
    text-align: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }
  .page-section__title {
    font-family: var(--font-heading-family);
    color: var(--color-text-primary, #F3EBDD);
    font-size: clamp(2.2rem, 3.8vw, 3.25rem);
    font-weight: 400;
    margin: 0.5rem 0 0;
    line-height: 1.15;
  }
  .page-section__content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-secondary, #B8B5A9);
  }
  .page-section__content h2,
  .page-section__content h3,
  .page-section__content h4 {
    font-family: var(--font-heading-family);
    color: var(--color-text-primary, #F3EBDD);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 400;
  }
  .page-section__content p {
    margin-bottom: 1.5rem;
  }
  .page-section__content a {
    color: var(--color-accent, #C9A46A);
    text-decoration: underline;
    transition: color 0.2s ease;
  }
  .page-section__content a:hover {
    color: var(--color-accent-hover, #D9B982);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
