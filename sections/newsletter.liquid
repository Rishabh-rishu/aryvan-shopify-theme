<section class="newsletter full-width newsletter--theme-{{ section.settings.color_scheme }}" id="newsletter">
  <div class="newsletter__container">
    <div class="newsletter__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow newsletter__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="newsletter__subtext">{{ section.settings.text }}</p>
      {% endif %}

      <div class="newsletter__form-wrapper">
        {% form 'customer', class: 'newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="newsletter__input-group">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="newsletter__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}"
              required
            >
            <button
              type="submit"
              class="button button-gold newsletter__button"
              name="commit"
            >
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="newsletter__message newsletter__message--success" role="status">
              {{ 'newsletter.success' | t | default: 'Thank you for joining our circle. Welcome to Aryvan Botanical Wellness.' }}
            </p>
          {% elsif form.errors %}
            <p class="newsletter__message newsletter__message--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {% endif %}
        {% endform %}
      </div>

      {% if section.settings.footer_note != blank %}
        <span class="newsletter__footnote">{{ section.settings.footer_note }}</span>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .newsletter {
    padding: 7rem 0;
    text-align: center;
  }

  .newsletter--theme-forest {
    background-color: var(--color-primary, #1F3025);
    color: #F8F5EF;
  }

  .newsletter--theme-forest .newsletter__heading {
    color: #F8F5EF;
  }

  .newsletter--theme-forest .newsletter__subtext {
    color: #F1EADF;
    opacity: 0.9;
  }

  .newsletter--theme-forest .eyebrow {
    color: var(--color-accent, #C7A77A);
  }

  .newsletter--theme-forest .newsletter__footnote {
    color: #A4AE98;
  }

  .newsletter--theme-cream {
    background-color: var(--color-surface, #F1EADF);
    color: var(--color-foreground, #292D29);
  }

  .newsletter__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .newsletter__content {
    max-width: 660px;
    margin: 0 auto;
  }

  .newsletter__heading {
    margin-bottom: 0.85rem;
  }

  .newsletter__subtext {
    font-size: 1.15rem;
    line-height: 1.65;
    margin-bottom: 2.75rem;
  }

  .newsletter__form-wrapper {
    margin-bottom: 1.25rem;
  }

  .newsletter__input-group {
    display: flex;
    gap: 0.75rem;
    max-width: 520px;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    padding: 0.95rem 1.35rem;
    border: 1px solid rgba(228, 221, 209, 0.4);
    background-color: #FFFFFF;
    color: #292D29;
    border-radius: var(--style-border-radius-inputs, 2px);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .newsletter__input:focus {
    border-color: var(--color-accent, #C7A77A);
  }

  .newsletter__button {
    white-space: nowrap;
  }

  .newsletter__message {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    padding: 0.75rem 1.25rem;
    border-radius: 2px;
  }

  .newsletter__message--success {
    background-color: rgba(199, 167, 122, 0.15);
    color: var(--color-accent, #C7A77A);
    border: 1px solid rgba(199, 167, 122, 0.35);
  }

  .newsletter__message--error {
    background-color: rgba(180, 50, 50, 0.1);
    color: #ffb4b4;
  }

  .newsletter__footnote {
    display: block;
    font-size: 0.82rem;
    margin-top: 1.25rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .newsletter {
      padding: 4.5rem 0;
    }
    .newsletter__input-group {
      flex-direction: column;
    }
    .newsletter__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "forest", "label": "Deep Forest Green" },
        { "value": "cream", "label": "Soft Cream" }
      ],
      "default": "forest"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "STAY IN RHYTHM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Botanical Journal"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Thoughtful notes on botanical rituals, natural beauty and conscious living."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footnote",
      "default": "We honor your tranquility. Never spam, only quiet herbal wisdom."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
