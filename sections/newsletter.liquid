<section class="newsletter full-width newsletter--theme-{{ section.settings.color_scheme }}">
  <div class="newsletter__container">
    <div class="newsletter__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow newsletter__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="newsletter__subtext">{{ section.settings.text }}</p>
      {% endif %}

      <div class="newsletter__form-wrapper">
        {% form 'customer', class: 'newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="newsletter__input-group">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="newsletter__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}"
              required
            >
            <button
              type="submit"
              class="button button-primary newsletter__button"
              name="commit"
            >
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="newsletter__message newsletter__message--success" role="status">
              {{ 'newsletter.success' | t }}
            </p>
          {% elsif form.errors %}
            <p class="newsletter__message newsletter__message--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {% endif %}
        {% endform %}
      </div>

      {% if section.settings.footer_note != blank %}
        <span class="newsletter__footnote">{{ section.settings.footer_note }}</span>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .newsletter {
    padding: 6rem 0;
    text-align: center;
  }

  .newsletter--theme-sage {
    background-color: #EAEFE8;
  }

  .newsletter--theme-cream {
    background-color: var(--color-surface, #F4EFE6);
  }

  .newsletter--theme-forest {
    background-color: var(--color-primary, #263629);
    color: #FBF9F5;
  }

  .newsletter--theme-forest .newsletter__heading,
  .newsletter--theme-forest .newsletter__subtext,
  .newsletter--theme-forest .newsletter__footnote {
    color: #FBF9F5;
  }

  .newsletter--theme-forest .eyebrow {
    color: var(--color-accent, #C49A6C);
  }

  .newsletter--theme-forest .button-primary {
    background-color: var(--color-accent, #C49A6C);
    border-color: var(--color-accent, #C49A6C);
    color: #232E24;
  }

  .newsletter--theme-forest .button-primary:hover {
    background-color: #FBF9F5;
    border-color: #FBF9F5;
    color: #232E24;
  }

  .newsletter__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .newsletter__content {
    max-width: 620px;
    margin: 0 auto;
  }

  .newsletter__heading {
    margin-bottom: 0.75rem;
  }

  .newsletter__subtext {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 2.25rem;
    opacity: 0.88;
  }

  .newsletter__form-wrapper {
    margin-bottom: 1rem;
  }

  .newsletter__input-group {
    display: flex;
    gap: 0.5rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--color-border, #E6E1D6);
    background-color: #FFFFFF;
    color: #232E24;
    border-radius: var(--style-border-radius-inputs, 4px);
    font-size: 0.95rem;
    outline: none;
  }

  .newsletter__input:focus {
    border-color: var(--color-secondary, #5B6E5D);
  }

  .newsletter__message {
    margin-top: 1rem;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 4px;
  }

  .newsletter__message--success {
    background-color: rgba(91, 110, 93, 0.15);
    color: var(--color-primary, #263629);
  }

  .newsletter__message--error {
    background-color: rgba(180, 50, 50, 0.1);
    color: #900;
  }

  .newsletter__footnote {
    display: block;
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: 1rem;
  }

  @media (max-width: 600px) {
    .newsletter {
      padding: 4rem 0;
    }
    .newsletter__input-group {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Warm Cream" },
        { "value": "sage", "label": "Soft Sage" },
        { "value": "forest", "label": "Deep Forest" }
      ],
      "default": "sage"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Stay In Rhythm"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Botanical Journal"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Receive seasonal harvest notes, herbal formulations, and exclusive private offerings directly to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footnote",
      "default": "We respect your quiet space. No synthetic clutter, ever."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
