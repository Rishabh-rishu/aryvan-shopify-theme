<section class="brand-values full-width brand-values--theme-{{ section.settings.color_theme }}">
  <div class="brand-values__container">
    {% if section.settings.heading != blank %}
      <div class="brand-values__header">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow brand-values__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="brand-values__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="brand-values__grid">
      {% for block in section.blocks %}
        <div class="brand-values__item" {{ block.shopify_attributes }}>
          <div class="brand-values__icon">
            {% case block.settings.icon %}
              {% when 'droplet' %}
                {{ 'icon-droplet.svg' | inline_asset_content }}
              {% when 'sun' %}
                {{ 'icon-sun.svg' | inline_asset_content }}
              {% when 'shield' %}
                {{ 'icon-shield.svg' | inline_asset_content }}
              {% else %}
                {{ 'icon-leaf.svg' | inline_asset_content }}
            {% endcase %}
          </div>
          <h3 class="brand-values__title">{{ block.settings.title }}</h3>
          <p class="brand-values__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-values {
    padding: 6.5rem 0;
    transition: background-color 0.3s ease;
  }

  .brand-values--theme-dark {
    background-color: var(--color-primary, #1F3025);
    color: #F8F5EF;
  }

  .brand-values--theme-dark .brand-values__eyebrow {
    color: var(--color-accent, #C7A77A);
  }

  .brand-values--theme-dark .brand-values__heading {
    color: #F8F5EF;
  }

  .brand-values--theme-dark .brand-values__title {
    color: #F8F5EF;
  }

  .brand-values--theme-dark .brand-values__text {
    color: #E4DDD1;
    opacity: 0.88;
  }

  .brand-values--theme-dark .brand-values__icon {
    background-color: rgba(199, 167, 122, 0.12);
    border: 1px solid rgba(199, 167, 122, 0.3);
    color: var(--color-accent, #C7A77A);
  }

  .brand-values--theme-light {
    background-color: var(--color-surface, #F1EADF);
    color: var(--color-foreground, #292D29);
    border-top: 1px solid var(--color-border, #E4DDD1);
    border-bottom: 1px solid var(--color-border, #E4DDD1);
  }

  .brand-values--theme-light .brand-values__icon {
    background-color: rgba(31, 48, 37, 0.08);
    color: var(--color-primary, #1F3025);
  }

  .brand-values__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .brand-values__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 4rem;
  }

  .brand-values__heading {
    margin: 0;
  }

  .brand-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }

  .brand-values__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .brand-values__icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: transform 0.4s var(--ease-luxury);
  }

  .brand-values__item:hover .brand-values__icon {
    transform: scale(1.1);
  }

  .brand-values__icon svg {
    width: 28px;
    height: 28px;
  }

  .brand-values__title {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    margin-bottom: 0.65rem;
    line-height: 1.25;
  }

  .brand-values__text {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .brand-values__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .brand-values {
      padding: 4.5rem 0;
    }
    .brand-values__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand values",
  "settings": [
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        { "value": "dark", "label": "Deep Forest Green" },
        { "value": "light", "label": "Soft Cream" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "OUR COMMITMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guided by Purity & Reverence"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Botanical Leaf" },
            { "value": "shield", "label": "Purity Shield" },
            { "value": "droplet", "label": "Oil Droplet" },
            { "value": "sun", "label": "Artisanal Sun" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtfully Sourced"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Ethically gathered botanicals sourced from organic cultivators and wildcrafters respecting seasonal rhythms."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "leaf",
            "title": "Thoughtfully Sourced",
            "text": "Ethically gathered botanicals sourced from regenerative cultivators and conscious wildcrafters."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "droplet",
            "title": "Nature-Inspired Formulations",
            "text": "Every elixir and balm is formulated with whole plant extracts, unadulterated by synthetic carriers."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "shield",
            "title": "Conscious Packaging",
            "text": "Encased in recyclable amber apothecary glass to preserve fragile phyto-nutrients and respect the earth."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "sun",
            "title": "Artisanal Attention to Detail",
            "text": "Compounded slowly in limited batches to ensure exceptional biological integrity and fresh vitality."
          }
        }
      ]
    }
  ]
}
{% endschema %}
