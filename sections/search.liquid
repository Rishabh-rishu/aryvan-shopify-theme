{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<section class="search-section full-width">
  <div class="search-section__container">
    <div class="search-section__header">
      <span class="eyebrow">BOTANICAL APOTHECARY</span>
      <h1 class="search-section__title">{{ 'search.title' | t | default: 'Search Formulations' }}</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <div class="search-form__inner">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t | default: 'Search by botanical, ailment or formula...' }}"
          class="search-form__input"
          aria-label="{{ 'search.title' | t }}"
        >
        <button type="submit" class="button button-primary search-form__submit">
          {{ 'search.submit' | t | default: 'Search' }}
        </button>
      </div>
    </form>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="search-empty">
          <p class="search-empty__text">{{ 'search.no_results_html' | t: terms: search.terms | default: 'No botanical formulations found matching your query.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button-secondary">
            Explore All Formulations
          </a>
        </div>
      {% else %}
        <div class="search-summary">
          <p class="search-summary__count">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
        </div>

        {% paginate search.results by 24 %}
          <div class="search-results">
            {% for result in search.results %}
              <div class="search-result-card">
                {% assign featured_image = result.featured_image | default: result.image %}
                <div class="search-result-card__media">
                  {% if featured_image %}
                    {% render 'image', class: 'search-result-card__image', image: featured_image, url: result.url, width: 600 %}
                  {% else %}
                    <a href="{{ result.url }}" class="search-result-card__placeholder">
                      <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a10 10 0 0 1 10 10c0 5.25-3.5 8.5-8.5 9.5-1.5.3-3.5.5-4.5.5C4 22 2 19 2 12A10 10 0 0 1 12 2z"/>
                        <path d="M7 12c1.5-2 3.5-3 5-3s3.5 1 5 3"/>
                        <path d="M12 9v9"/>
                      </svg>
                    </a>
                  {% endif %}
                </div>
                <div class="search-result-card__content">
                  <a href="{{ result.url }}" class="search-result-card__title">{{ result.title }}</a>
                  {% if result.price %}
                    <span class="search-result-card__price">{{ result.price | money }}</span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="search-pagination" aria-label="Pagination">
              {{ paginate | default_pagination }}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .search-section {
    padding: 4rem 0 7rem;
    background-color: var(--color-bg-primary, #0B1510);
    color: var(--color-text-primary, #F3EBDD);
    min-height: 70vh;
  }
  .search-section__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }
  .search-section__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .search-section__title {
    font-family: var(--font-heading-family);
    color: var(--color-text-primary, #F3EBDD);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 400;
    margin: 0.5rem 0 0;
  }
  .search-form {
    max-width: 640px;
    margin: 0 auto 3.5rem;
  }
  .search-form__inner {
    display: flex;
    gap: 0.75rem;
  }
  .search-form__input {
    flex-grow: 1;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.3));
    color: var(--color-text-primary, #F3EBDD);
    padding: 0.85rem 1.25rem;
    border-radius: 3px;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .search-form__input:focus {
    border-color: var(--color-accent, #C9A46A);
  }
  .search-form__submit {
    flex-shrink: 0;
    padding: 0.85rem 1.75rem;
  }
  .search-summary {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    color: var(--color-text-secondary, #B8B5A9);
    font-size: 0.95rem;
  }
  .search-empty {
    text-align: center;
    padding: 4rem 1rem;
  }
  .search-empty__text {
    font-size: 1.1rem;
    color: var(--color-text-secondary, #B8B5A9);
    margin-bottom: 2rem;
  }
  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }
  .search-result-card {
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .search-result-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent, #C9A46A);
  }
  .search-result-card__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-bg-primary, #0B1510);
  }
  .search-result-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-accent, #C9A46A);
    opacity: 0.7;
    text-decoration: none;
  }
  .search-result-card__content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .search-result-card__title {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    color: var(--color-text-primary, #F3EBDD);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .search-result-card__title:hover {
    color: var(--color-accent, #C9A46A);
  }
  .search-result-card__price {
    color: var(--color-accent, #C9A46A);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .search-pagination {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }
  .search-pagination a,
  .search-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.75rem;
    margin: 0 0.25rem;
    font-size: 0.9rem;
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: 3px;
    text-decoration: none;
    color: var(--color-text-primary, #F3EBDD);
    background-color: var(--color-bg-card, #18271F);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .search-pagination a:hover {
    border-color: var(--color-accent, #C9A46A);
    color: var(--color-accent, #C9A46A);
    background-color: var(--color-bg-secondary, #122019);
  }
  .search-pagination .current {
    background-color: var(--color-accent, #C9A46A);
    color: var(--color-bg-primary, #0B1510);
    border-color: var(--color-accent, #C9A46A);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .search-form__inner {
      flex-direction: column;
    }
    .search-results {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
