<div
  class="hero-banner full-width hero-banner--align-{{ section.settings.alignment }}"
  style="
    --hero-min-height: {{ section.settings.min_height }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {% if section.settings.image != blank %}
    <div class="hero-banner__image-wrapper">
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-banner__image', loading: 'eager', fetchpriority: 'high' }}
    </div>
  {% else %}
    <div class="hero-banner__pattern-wrapper" aria-hidden="true">
      <svg class="hero-banner__pattern" viewBox="0 0 1440 800" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="1440" height="800" fill="#F4EFE6"/>
        <circle cx="1200" cy="200" r="350" fill="#E8E2D5" fill-opacity="0.5"/>
        <circle cx="200" cy="700" r="400" fill="#EAECE6" fill-opacity="0.6"/>
        <path d="M720 100C850 250 900 450 780 650C660 850 450 700 400 500C350 300 590 -50 720 100Z" fill="#DCE3DA" fill-opacity="0.35"/>
        <path d="M1100 400C1250 500 1300 700 1200 850" stroke="#C49A6C" stroke-width="1.5" stroke-dasharray="6 6" stroke-opacity="0.4"/>
      </svg>
    </div>
  {% endif %}

  <div class="hero-banner__overlay"></div>

  <div class="hero-banner__content-container">
    <div class="hero-banner__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow hero-banner__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="hero-banner__text">{{ section.settings.text }}</p>
      {% endif %}

      <div class="hero-banner__actions">
        {% if section.settings.primary_button_label != blank %}
          <a
            href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
            class="button button-primary hero-banner__btn"
          >
            {{ section.settings.primary_button_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_button_label != blank %}
          <a
            href="{{ section.settings.secondary_button_link | default: '#brand-story' }}"
            class="button button-secondary hero-banner__btn"
          >
            {{ section.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    min-height: var(--hero-min-height, 620px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-surface, #F4EFE6);
  }

  .hero-banner__image-wrapper,
  .hero-banner__pattern-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__pattern {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(251, 249, 245, 0.4) 0%,
      rgba(244, 239, 230, 0.75) 100%
    );
    opacity: var(--hero-overlay-opacity, 0.6);
    z-index: 2;
  }

  .hero-banner__content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 4rem var(--page-margin);
    display: flex;
  }

  .hero-banner--align-center .hero-banner__content-container {
    justify-content: center;
    text-align: center;
  }

  .hero-banner--align-left .hero-banner__content-container {
    justify-content: flex-start;
    text-align: left;
  }

  .hero-banner__content {
    max-width: 680px;
  }

  .hero-banner__heading {
    margin-bottom: 1.25rem;
    color: var(--color-foreground, #232E24);
  }

  .hero-banner__text {
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-foreground, #232E24);
    opacity: 0.9;
    margin-bottom: 2.25rem;
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-banner--align-center .hero-banner__actions {
    justify-content: center;
  }

  @media (max-width: 768px) {
    .hero-banner {
      min-height: 520px;
    }
    .hero-banner__content-container {
      padding: 3rem var(--page-margin);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Aryvan Botanical Wellness"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Harmonize Body & Spirit Through Plant Wisdom"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Ethically harvested organic botanicals and artisanal alchemy crafted to restore calm, vitality, and holistic well-being."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Explore Our Ethos"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum banner height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
