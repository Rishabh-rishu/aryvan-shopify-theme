<div
  class="hero-banner full-width hero-banner--align-{{ section.settings.alignment }}"
  style="
    --hero-min-height: {{ section.settings.min_height }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <!-- Background Image with fallback to temporary luxury botanical photography -->
  <div class="hero-banner__media-wrapper">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero-banner__image', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading | escape }}
    {% else %}
      <img
        src="{{ 'temp-hero-botanical.webp' | asset_url }}"
        alt="Lush botanical foliage in soft natural sunlight"
        class="hero-banner__image"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  <!-- Soft Sunlight Caustic Glow -->
  <div class="hero-banner__sunlight" aria-hidden="true"></div>

  <!-- Dark Botanical Vignette & Overlay -->
  <div class="hero-banner__overlay" aria-hidden="true"></div>

  <!-- Subtle Floating Botanical Leaves -->
  {% if section.settings.enable_floating_leaves %}
    <div class="hero-banner__leaves" aria-hidden="true">
      <div class="hero-leaf hero-leaf--1">
        {{ 'leaf-float-1.svg' | inline_asset_content }}
      </div>
      <div class="hero-leaf hero-leaf--2">
        {{ 'leaf-float-2.svg' | inline_asset_content }}
      </div>
      <div class="hero-leaf hero-leaf--3">
        {{ 'leaf-float-1.svg' | inline_asset_content }}
      </div>
      <div class="hero-leaf hero-leaf--4">
        {{ 'leaf-float-2.svg' | inline_asset_content }}
      </div>
    </div>
  {% endif %}

  <!-- Hero Content -->
  <div class="hero-banner__content-container">
    <div class="hero-banner__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow hero-banner__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="hero-banner__text">{{ section.settings.text }}</p>
      {% endif %}

      <div class="hero-banner__actions">
        {% if section.settings.primary_button_label != blank %}
          <a
            href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
            class="button button-gold hero-banner__btn"
          >
            {{ section.settings.primary_button_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_button_label != blank %}
          <a
            href="{{ section.settings.secondary_button_link | default: '#brand-story' }}"
            class="button button-outline-light hero-banner__btn"
          >
            {{ section.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    min-height: var(--hero-min-height, 680px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #1F3025;
  }

  .hero-banner__media-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    transform: scale(1.02);
    transition: transform 12s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Soft Sunlight Caustic Effect */
  .hero-banner__sunlight {
    position: absolute;
    top: -15%;
    right: 10%;
    width: 55vw;
    height: 55vw;
    max-width: 800px;
    max-height: 800px;
    background: radial-gradient(
      circle,
      rgba(248, 245, 239, 0.22) 0%,
      rgba(199, 167, 122, 0.15) 40%,
      rgba(31, 48, 37, 0) 70%
    );
    filter: blur(50px);
    pointer-events: none;
    z-index: 2;
    animation: sunlightCaustic 12s ease-in-out infinite alternate;
  }

  /* Cinematic Vignette Overlay */
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(25, 38, 29, 0.45) 0%,
      rgba(31, 48, 37, 0.72) 65%,
      rgba(20, 31, 24, 0.88) 100%
    );
    opacity: var(--hero-overlay-opacity, 0.75);
    z-index: 3;
    pointer-events: none;
  }

  /* Floating Leaves Layer */
  .hero-banner__leaves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 4;
  }

  .hero-leaf {
    position: absolute;
    opacity: 0.65;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.25));
  }

  .hero-leaf svg {
    width: 100%;
    height: 100%;
  }

  .hero-leaf--1 {
    top: 18%;
    right: 12%;
    width: 72px;
    height: 115px;
    animation: leafFloatSlow 18s ease-in-out infinite;
  }

  .hero-leaf--2 {
    top: 55%;
    right: 25%;
    width: 50px;
    height: 85px;
    opacity: 0.45;
    animation: leafFloatGentle 24s ease-in-out infinite;
    animation-delay: -6s;
  }

  .hero-leaf--3 {
    top: 25%;
    left: 8%;
    width: 60px;
    height: 96px;
    opacity: 0.55;
    animation: leafFloatGentle 20s ease-in-out infinite;
    animation-delay: -10s;
  }

  .hero-leaf--4 {
    bottom: 15%;
    left: 20%;
    width: 44px;
    height: 75px;
    opacity: 0.4;
    animation: leafFloatSlow 22s ease-in-out infinite;
    animation-delay: -4s;
  }

  /* Content Container */
  .hero-banner__content-container {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 6rem var(--page-margin);
    display: flex;
  }

  .hero-banner--align-center .hero-banner__content-container {
    justify-content: center;
    text-align: center;
  }

  .hero-banner--align-left .hero-banner__content-container {
    justify-content: flex-start;
    text-align: left;
  }

  .hero-banner__content {
    max-width: 780px;
    animation: heroFadeInUp 1.2s var(--ease-luxury) forwards;
  }

  .hero-banner__eyebrow {
    color: var(--color-accent, #C7A77A);
    letter-spacing: 0.24em;
    font-size: 0.78rem;
    margin-bottom: 1.25rem;
  }

  .hero-banner__heading {
    color: #F8F5EF;
    font-size: clamp(2.75rem, 5.5vw + 1rem, 5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .hero-banner__text {
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    line-height: 1.65;
    color: #F1EADF;
    opacity: 0.94;
    margin-bottom: 2.75rem;
    max-width: 620px;
  }

  .hero-banner--align-center .hero-banner__text {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .hero-banner--align-center .hero-banner__actions {
    justify-content: center;
  }

  @media (max-width: 768px) {
    .hero-banner {
      min-height: 560px;
    }
    .hero-banner__content-container {
      padding: 4rem var(--page-margin);
    }
    .hero-banner__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-banner__actions .button {
      width: 100%;
    }
    .hero-leaf--2,
    .hero-leaf--4 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-leaf {
      animation: none !important;
    }
    .hero-banner__sunlight {
      animation: none !important;
    }
    .hero-banner__image {
      transform: none !important;
    }
    .hero-banner__content {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom background image"
    },
    {
      "type": "checkbox",
      "id": "enable_floating_leaves",
      "label": "Enable floating botanical leaves animation",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "ARYVAN BOTANICAL WELLNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nature, Thoughtfully Refined."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Discover the harmony of botanical wisdom and modern wellness."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum banner height",
      "min": 450,
      "max": 850,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
