{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="password-section full-width">
  <div class="password-section__container">
    <div class="password-section__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 0 1 10 10c0 5.25-3.5 8.5-8.5 9.5-1.5.3-3.5.5-4.5.5C4 22 2 19 2 12A10 10 0 0 1 12 2z"/>
        <path d="M7 12c1.5-2 3.5-3 5-3s3.5 1 5 3"/>
        <path d="M12 9v9"/>
      </svg>
    </div>
    <span class="eyebrow">{{ shop.name }} &mdash; PRIVATE HARVEST</span>
    <h1 class="password-section__title">{{ 'password.title' | t | default: 'Opening Soon to Patrons' }}</h1>

    {% if shop.password_message != blank %}
      <p class="password-section__message">{{ shop.password_message }}</p>
    {% else %}
      <p class="password-section__message">
        Our living botanical apothecaries are currently formulating in small seasonal batches. Enter password for private sanctuary access.
      </p>
    {% endif %}

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        <div class="password-form__errors">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="password-form__inner">
        <label for="password-input" class="sr-only">
          {{ 'password.password' | t | default: 'Password' }}
        </label>
        <input
          type="password"
          name="password"
          id="password-input"
          placeholder="{{ 'password.password' | t | default: 'Store password' }}"
          class="password-form__input"
          required
        >
        <button type="submit" class="button button-primary password-form__submit">
          {{ 'password.enter' | t | default: 'Enter Sanctuary' }}
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .password-section {
    padding: 6rem 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: var(--color-bg-primary, #0B1510);
    color: var(--color-text-primary, #F3EBDD);
  }
  .password-section__container {
    max-width: 580px;
    margin: 0 auto;
    padding: 2rem var(--page-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .password-section__icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    color: var(--color-accent, #C9A46A);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }
  .password-section__title {
    font-family: var(--font-heading-family);
    color: var(--color-text-primary, #F3EBDD);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0.5rem 0 1.25rem;
  }
  .password-section__message {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #B8B5A9);
    margin-bottom: 2.5rem;
  }
  .password-form {
    width: 100%;
    max-width: 460px;
  }
  .password-form__inner {
    display: flex;
    gap: 0.75rem;
  }
  .password-form__input {
    flex-grow: 1;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.3));
    color: var(--color-text-primary, #F3EBDD);
    padding: 0.85rem 1.25rem;
    border-radius: 3px;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .password-form__input:focus {
    border-color: var(--color-accent, #C9A46A);
  }
  .password-form__submit {
    flex-shrink: 0;
  }
  .password-form__errors {
    color: #E57373;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  @media (max-width: 540px) {
    .password-form__inner {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
