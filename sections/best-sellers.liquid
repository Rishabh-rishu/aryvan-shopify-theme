<div class="best-sellers full-width">
  <div class="best-sellers__container">
    <div class="best-sellers__header">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="best-sellers__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="best-sellers__subtext">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% assign featured_collection = section.settings.collection %}

    {% if featured_collection != blank and featured_collection.products.size > 0 %}
      <div class="best-sellers__grid best-sellers__grid--cols-{{ section.settings.columns_desktop }}">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      {% if section.settings.show_view_all and featured_collection.url != blank %}
        <div class="best-sellers__footer">
          <a href="{{ featured_collection.url }}" class="button button-secondary">
            {{ 'collections.view_collection' | t | default: 'View All Formulations' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <!-- Intentional Luxury Botanical Showcase / Empty State -->
      <div class="best-sellers__showcase">
        <div class="best-sellers__showcase-media editorial-card">
          <img
            src="{{ 'temp-wellness-ritual.webp' | asset_url }}"
            alt="Artisanal botanical oil and amber apothecary bottles"
            class="editorial-card__img"
            width="1000"
            height="1200"
            loading="lazy"
          >
        </div>

        <div class="best-sellers__showcase-content">
          <span class="eyebrow">{{ 'products.empty' | t | default: 'Artisanal Small Batches' }}</span>
          <h3 class="best-sellers__showcase-title">Fresh Harvest Formulations in Preparation</h3>
          <p class="best-sellers__showcase-text">
            Our apothecaries are currently slow-macerating seasonal harvests in small amber vessels. We prioritize living phytochemical potency over mass industrialization.
          </p>
          <p class="best-sellers__showcase-text">
            Once products are configured in your Shopify admin or selected in the Theme Editor, your best sellers will appear here seamlessly.
          </p>
          <div class="best-sellers__showcase-actions">
            <a href="#brand-story" class="button button-primary">
              Discover Our Ethos
            </a>
            <a href="#newsletter" class="button button-secondary">
              Join Harvest Previews
            </a>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .best-sellers {
    padding: 6.5rem 0;
    background-color: var(--color-bg-secondary, #122019);
    border-top: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .best-sellers__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .best-sellers__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4rem;
  }

  .best-sellers__heading {
    margin-bottom: 0.85rem;
    color: var(--color-text-primary, #F3EBDD);
  }

  .best-sellers__subtext {
    font-size: 1.1rem;
    color: var(--color-text-secondary, #B8B5A9);
    opacity: 0.9;
  }

  .best-sellers__grid {
    display: grid;
    gap: 2.25rem;
  }

  .best-sellers__grid--cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .best-sellers__grid--cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Intentional Botanical Showcase when collection is empty */
  .best-sellers__showcase {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4rem;
    align-items: center;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: var(--style-border-radius-cards, 4px);
    padding: 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .best-sellers__showcase-media {
    aspect-ratio: 4 / 4.8;
    overflow: hidden;
    background-color: var(--color-bg-primary, #0B1510);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.15));
    border-radius: 4px;
  }

  .best-sellers__showcase-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .best-sellers__showcase-title {
    font-family: var(--font-heading-family, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.85rem, 2.5vw, 2.5rem);
    line-height: 1.2;
    color: var(--color-text-primary, #F3EBDD);
    margin: 0;
  }

  .best-sellers__showcase-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #B8B5A9);
    opacity: 0.92;
    margin: 0;
  }

  .best-sellers__showcase-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .best-sellers__footer {
    margin-top: 4rem;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .best-sellers__grid--cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .best-sellers__showcase {
      grid-template-columns: 1fr;
      padding: 2.25rem;
      gap: 2.5rem;
    }
  }

  @media (max-width: 680px) {
    .best-sellers {
      padding: 4.5rem 0;
    }
    .best-sellers__grid--cols-3,
    .best-sellers__grid--cols-4 {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .best-sellers__showcase-actions {
      flex-direction: column;
    }
    .best-sellers__showcase-actions .button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Best sellers",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Aryvan Essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Selling Formulations"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Time-honored botanical remedies crafted with whole plants, therapeutic essences, and pure natural intention."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Best sellers"
    }
  ]
}
{% endschema %}
