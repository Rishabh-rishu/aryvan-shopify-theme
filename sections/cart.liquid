{% comment %}
  Aryvan Botanical Wellness - Luxury Cart Section
  Renders /cart overview with unit prices, line totals, subtotal, and responsive layout.
{% endcomment %}

<section class="cart-section full-width">
  <div class="cart-section__container">
    <div class="cart-section__header">
      <span class="eyebrow cart-section__eyebrow">Your Selections</span>
      <h1 class="cart-section__title">{{ 'cart.title' | t | default: 'Your Botanical Cart' }}</h1>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form" id="cart-form">
        <div class="cart-table-wrapper">
          <table class="cart-table">
            <thead>
              <tr class="cart-table__head-row">
                <th scope="col" class="cart-table__col cart-table__col--product">Product</th>
                <th scope="col" class="cart-table__col cart-table__col--price">Price</th>
                <th scope="col" class="cart-table__col cart-table__col--quantity">Quantity</th>
                <th scope="col" class="cart-table__col cart-table__col--total">Total</th>
              </tr>
            </thead>
            <tbody>
              {% for item in cart.items %}
                <tr class="cart-item">
                  <td class="cart-item__product-cell">
                    <div class="cart-item__media-wrapper">
                      {% render 'image', image: item.image, url: item.url, class: 'cart-item__image' %}
                    </div>
                    <div class="cart-item__details">
                      <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                      {% unless item.product.has_only_default_variant %}
                        <span class="cart-item__variant-title">{{ item.variant.title }}</span>
                      {% endunless %}
                      <div class="cart-item__mobile-price">
                        <span>{{ item.final_price | money }}</span>
                      </div>
                      <div class="cart-item__remove-wrapper">
                        {{ 'cart.remove' | t | default: 'Remove' | link_to: item.url_to_remove, class: 'cart-item__remove-link' }}
                      </div>
                    </div>
                  </td>

                  <td class="cart-item__price-cell">
                    {% if item.original_price > item.final_price %}
                      <s class="cart-item__original-price">{{ item.original_price | money }}</s>
                    {% endif %}
                    <span class="cart-item__unit-price">{{ item.final_price | money }}</span>
                  </td>

                  <td class="cart-item__quantity-cell">
                    <div class="cart-item__quantity-group">
                      <label for="updates_{{ item.key }}" class="sr-only">Quantity for {{ item.product.title }}</label>
                      <input
                        type="number"
                        name="updates[]"
                        id="updates_{{ item.key }}"
                        class="cart-item__quantity-input"
                        value="{{ item.quantity }}"
                        min="0"
                        aria-label="Quantity for {{ item.product.title }}"
                      >
                      <button type="submit" name="update" class="cart-item__update-button">
                        {{ 'cart.update' | t | default: 'Update' }}
                      </button>
                    </div>
                  </td>

                  <td class="cart-item__total-cell">
                    <span class="cart-item__line-total">{{ item.final_line_price | money }}</span>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="cart-summary">
          <div class="cart-summary__inner">
            <div class="cart-summary__row cart-summary__subtotal-row">
              <span class="cart-summary__label">Subtotal</span>
              <span class="cart-summary__subtotal-amount">{{ cart.total_price | money }}</span>
            </div>

            <p class="cart-summary__note">Taxes and shipping calculated at checkout.</p>

            <div class="cart-summary__actions">
              <button type="submit" name="update" class="btn btn--secondary cart-summary__update-btn">
                {{ 'cart.update' | t | default: 'Update Cart' }}
              </button>
              <button type="submit" name="checkout" class="btn btn--primary cart-summary__checkout-btn">
                {{ 'cart.checkout' | t | default: 'Proceed to Checkout' }}
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="cart-summary__continue-link">
                &larr; Continue Exploring
              </a>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div class="cart-empty">
        <div class="cart-empty__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 0 1 10 10c0 5.25-3.5 8.5-8.5 9.5-1.5.3-3.5.5-4.5.5C4 22 2 19 2 12A10 10 0 0 1 12 2z"/>
            <path d="M7 12c1.5-2 3.5-3 5-3s3.5 1 5 3"/>
            <path d="M12 9v9"/>
          </svg>
        </div>
        <h2 class="cart-empty__heading">Your Botanical Cart is Empty</h2>
        <p class="cart-empty__text">Explore our whole-plant formulations and intentional harvests to begin your daily wellness ritual.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary cart-empty__btn">
          Explore Formulations
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cart-section {
    padding: 4rem 0 6rem;
    background-color: var(--color-bg-primary, #0B1510);
    color: var(--color-text-primary, #F3EBDD);
    min-height: 60vh;
  }

  .cart-section__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .cart-section__header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .cart-section__eyebrow {
    margin-bottom: 0.5rem;
    color: var(--color-accent, #C9A46A);
  }

  .cart-section__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 400;
    color: var(--color-text-primary, #F3EBDD);
    margin: 0;
  }

  /* Table styling */
  .cart-table-wrapper {
    overflow-x: auto;
    margin-bottom: 2.5rem;
  }

  .cart-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .cart-table__head-row th {
    padding: 1rem 1.25rem 1rem 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary, #B8B5A9);
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .cart-table__col--price,
  .cart-table__col--total {
    text-align: right;
  }

  .cart-table__col--quantity {
    text-align: center;
  }

  .cart-item {
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .cart-item td {
    padding: 1.75rem 1.25rem 1.75rem 0;
    vertical-align: middle;
  }

  /* Product cell */
  .cart-item__product-cell {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .cart-item__media-wrapper {
    width: 90px;
    height: 90px;
    flex-shrink: 0;
    border-radius: 3px;
    overflow: hidden;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cart-item__title {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-primary, #F3EBDD);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cart-item__title:hover {
    color: var(--color-accent, #C9A46A);
  }

  .cart-item__variant-title {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #B8B5A9);
  }

  .cart-item__mobile-price {
    display: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent, #C9A46A);
  }

  .cart-item__remove-wrapper {
    margin-top: 0.25rem;
  }

  .cart-item__remove-link {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary, #B8B5A9);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .cart-item__remove-link:hover {
    color: var(--color-accent, #C9A46A);
  }

  /* Price & Total cells */
  .cart-item__price-cell {
    text-align: right;
    white-space: nowrap;
  }

  .cart-item__unit-price {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-accent, #C9A46A);
  }

  .cart-item__original-price {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #B8B5A9);
    margin-bottom: 0.15rem;
  }

  .cart-item__total-cell {
    text-align: right;
    white-space: nowrap;
  }

  .cart-item__line-total {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-accent, #C9A46A);
  }

  /* Quantity cell */
  .cart-item__quantity-cell {
    text-align: center;
  }

  .cart-item__quantity-group {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .cart-item__quantity-input {
    width: 64px;
    height: 40px;
    text-align: center;
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.3));
    background-color: var(--color-bg-card, #18271F);
    color: var(--color-text-primary, #F3EBDD);
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    border-radius: 3px;
    outline: none;
  }

  .cart-item__quantity-input:focus {
    border-color: var(--color-accent, #C9A46A);
  }

  .cart-item__update-button {
    background: none;
    border: none;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent, #C9A46A);
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }

  .cart-item__update-button:hover {
    color: var(--color-accent-hover, #D9B982);
  }

  /* Cart Summary */
  .cart-summary {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .cart-summary__inner {
    width: 100%;
    max-width: 420px;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: 4px;
    padding: 2rem;
  }

  .cart-summary__subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .cart-summary__label {
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    color: var(--color-text-primary, #F3EBDD);
  }

  .cart-summary__subtotal-amount {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-accent, #C9A46A);
  }

  .cart-summary__note {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #B8B5A9);
    margin: 0 0 1.75rem;
    font-style: italic;
  }

  .cart-summary__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-summary__update-btn {
    width: 100%;
    padding: 0.85rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  .cart-summary__checkout-btn {
    width: 100%;
    padding: 1rem;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background-color: var(--color-accent, #C9A46A);
    color: var(--color-bg-primary, #0B1510);
    border: none;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }

  .cart-summary__checkout-btn:hover {
    background-color: var(--color-accent-hover, #D9B982);
    transform: translateY(-2px);
  }

  .cart-summary__continue-link {
    text-align: center;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary, #B8B5A9);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cart-summary__continue-link:hover {
    color: var(--color-accent, #C9A46A);
  }

  /* Empty Cart State */
  .cart-empty {
    text-align: center;
    padding: 5rem 1rem;
    max-width: 520px;
    margin: 0 auto;
  }

  .cart-empty__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: var(--color-bg-card, #18271F);
    color: var(--color-accent, #C9A46A);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .cart-empty__heading {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 400;
    color: var(--color-text-primary, #F3EBDD);
    margin: 0 0 0.75rem;
  }

  .cart-empty__text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #B8B5A9);
    margin: 0 0 2rem;
  }

  .cart-empty__btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    background-color: var(--color-accent, #C9A46A);
    color: var(--color-bg-primary, #0B1510);
    border: none;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 600;
    border-radius: 3px;
    transition: background-color 0.25s ease, transform 0.2s ease;
  }

  .cart-empty__btn:hover {
    background-color: var(--color-accent-hover, #D9B982);
    transform: translateY(-2px);
  }

  /* Responsive Mobile */
  @media (max-width: 768px) {
    .cart-section {
      padding: 3rem 0 5rem;
    }

    .cart-table thead {
      display: none;
    }

    .cart-table, .cart-table tbody, .cart-item {
      display: block;
      width: 100%;
    }

    .cart-item {
      padding: 1.5rem 0;
      position: relative;
    }

    .cart-item td {
      display: block;
      padding: 0.5rem 0;
      text-align: left;
    }

    .cart-item__product-cell {
      align-items: flex-start;
      gap: 1.25rem;
    }

    .cart-item__media-wrapper {
      width: 76px;
      height: 76px;
    }

    .cart-item__mobile-price {
      display: block;
      margin-top: 0.25rem;
    }

    .cart-item__price-cell {
      display: none;
    }

    .cart-item__quantity-cell {
      text-align: left;
      padding-left: 92px;
    }

    .cart-item__quantity-group {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }

    .cart-item__total-cell {
      text-align: left;
      padding-left: 92px;
      padding-top: 0.25rem;
    }

    .cart-summary__inner {
      max-width: 100%;
      padding: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
