<aside
  class="announcement-bar"
  style="
    --announcement-bg: {{ section.settings.bg_color }};
    --announcement-text: {{ section.settings.text_color }};
  "
  aria-label="Announcement"
>
  <div class="announcement-bar__inner">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="announcement-bar__link">
        <span class="announcement-bar__message">{{ section.settings.text }}</span>
      </a>
    {% else %}
      <span class="announcement-bar__message">{{ section.settings.text }}</span>
    {% endif %}
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    background-color: var(--announcement-bg, #232E24);
    color: var(--announcement-text, #FBF9F5);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.65rem var(--page-margin);
    text-align: center;
    position: relative;
    z-index: 20;
  }

  .announcement-bar__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .announcement-bar__link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Complimentary botanical wellness consultation with every order over $75"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#232E24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FBF9F5"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
