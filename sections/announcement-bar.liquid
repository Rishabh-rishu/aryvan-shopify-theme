<aside
  class="announcement-bar"
  style="
    --announcement-bg: {{ section.settings.bg_color | default: '#1F3025' }};
    --announcement-text: {{ section.settings.text_color | default: '#F8F5EF' }};
  "
  aria-label="Announcement"
>
  <div class="announcement-bar__inner">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="announcement-bar__link">
        <span class="announcement-bar__message">{{ section.settings.text }}</span>
      </a>
    {% else %}
      <span class="announcement-bar__message">{{ section.settings.text }}</span>
    {% endif %}
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    background-color: var(--announcement-bg, #1F3025);
    color: var(--announcement-text, #F8F5EF);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.75rem var(--page-margin);
    text-align: center;
    position: relative;
    z-index: 25;
    border-bottom: 1px solid rgba(199, 167, 122, 0.2);
  }

  .announcement-bar__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .announcement-bar__link:hover {
    color: var(--color-accent, #C7A77A);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Complimentary artisanal botanical consultation with orders over $75"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1F3025"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F8F5EF"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
