{% if section.settings.show_section %}
  <section class="testimonials full-width">
    <div class="testimonials__container">
      <div class="testimonials__header">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="testimonials__subtext">{{ section.settings.text }}</p>
        {% endif %}
      </div>

      <div class="testimonials__grid">
        {% for block in section.blocks %}
          <div class="testimonials__card" {{ block.shopify_attributes }}>
            <span class="testimonials__quote-symbol" aria-hidden="true">&ldquo;</span>

            <blockquote class="testimonials__quote">
              <p>{{ block.settings.quote }}</p>
            </blockquote>

            <div class="testimonials__author-info">
              <cite class="testimonials__author-name">{{ block.settings.author }}</cite>
              {% if block.settings.subtitle != blank %}
                <span class="testimonials__author-subtitle">{{ block.settings.subtitle }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .testimonials {
    padding: 7rem 0;
    background-color: var(--color-bg-primary, #0B1510);
    border-top: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .testimonials__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .testimonials__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 4rem;
  }

  .testimonials__heading {
    margin-bottom: 0.85rem;
    color: var(--color-text-primary, #F3EBDD);
  }

  .testimonials__subtext {
    font-size: 1.1rem;
    color: var(--color-text-secondary, #B8B5A9);
    opacity: 0.9;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.25rem;
  }

  .testimonials__card {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: var(--style-border-radius-cards, 4px);
    position: relative;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .testimonials__quote-symbol {
    font-family: var(--font-heading-family, 'Cormorant Garamond', Georgia, serif);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-accent, #C9A46A);
    opacity: 0.75;
    margin-bottom: -1.5rem;
  }

  .testimonials__quote {
    font-family: var(--font-heading-family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.3rem;
    line-height: 1.55;
    font-style: italic;
    color: var(--color-text-primary, #F3EBDD);
    margin: 0 0 2rem;
    flex-grow: 1;
  }

  .testimonials__author-info {
    border-top: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .testimonials__author-name {
    font-size: 0.95rem;
    font-weight: 600;
    font-style: normal;
    color: var(--color-text-primary, #F3EBDD);
  }

  .testimonials__author-subtitle {
    font-size: 0.75rem;
    color: var(--color-accent, #C9A46A);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .testimonials {
      padding: 4.5rem 0;
    }
    .testimonials__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .testimonials__card {
      padding: 2.25rem 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show testimonials section",
      "info": "Enable when authentic customer reflections are available.",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "PATRON REFLECTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words From Our Circle"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Reflections from individuals embracing natural plant rituals into their daily rhythm."
    }
  ],
  "blocks": [
    {
      "type": "reflection",
      "name": "Patron Reflection",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Reflection / quote",
          "default": "The subtle aroma and pure botanical texture bring a moment of deep grounding to my evening routine. You can feel the intention behind every bottle."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Patron name",
          "default": "Elena R."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Patron subtitle",
          "default": "Botanical Wellness Member"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "reflection",
          "settings": {
            "quote": "The gentle botanical purity of Aryvan brings a grounding presence to morning meditation and daily restoration.",
            "author": "Marcus V.",
            "subtitle": "Patron Reflection"
          }
        },
        {
          "type": "reflection",
          "settings": {
            "quote": "You can immediately distinguish the artisan craft in these small-batch infusions. Clean, unadulterated, and deeply nourishing.",
            "author": "Claire T.",
            "subtitle": "Patron Reflection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
