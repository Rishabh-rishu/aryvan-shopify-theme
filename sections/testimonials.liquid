<section class="testimonials full-width">
  <div class="testimonials__container">
    <div class="testimonials__header">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="testimonials__subtext">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="testimonials__grid">
      {% for block in section.blocks %}
        <div class="testimonials__card botanical-card" {{ block.shopify_attributes }}>
          {% if section.settings.show_stars %}
            <div class="testimonials__stars" aria-label="5 out of 5 stars">
              {% for i in (1..5) %}
                {{ 'icon-star.svg' | inline_asset_content }}
              {% endfor %}
            </div>
          {% endif %}

          <blockquote class="testimonials__quote">
            <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
          </blockquote>

          <div class="testimonials__author-info">
            <cite class="testimonials__author-name">{{ block.settings.author }}</cite>
            {% if block.settings.subtitle != blank %}
              <span class="testimonials__author-subtitle">{{ block.settings.subtitle }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .testimonials {
    padding: 6rem 0;
    background-color: var(--color-background, #FBF9F5);
  }

  .testimonials__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .testimonials__header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 3.5rem;
  }

  .testimonials__heading {
    margin-bottom: 0.75rem;
  }

  .testimonials__subtext {
    font-size: 1.05rem;
    color: var(--color-foreground, #232E24);
    opacity: 0.85;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .testimonials__card {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    background-color: var(--color-surface, #F4EFE6);
  }

  .testimonials__stars {
    display: flex;
    gap: 0.25rem;
    color: var(--color-accent, #C49A6C);
    margin-bottom: 1.25rem;
  }

  .testimonials__stars svg {
    width: 15px;
    height: 15px;
  }

  .testimonials__quote {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.2rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--color-primary, #263629);
    margin: 0 0 1.75rem;
    flex-grow: 1;
  }

  .testimonials__author-info {
    border-top: 1px solid var(--color-border, #E6E1D6);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .testimonials__author-name {
    font-size: 0.9rem;
    font-weight: 600;
    font-style: normal;
    color: var(--color-foreground, #232E24);
  }

  .testimonials__author-subtitle {
    font-size: 0.75rem;
    color: var(--color-secondary, #5B6E5D);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .testimonials {
      padding: 4rem 0;
    }
    .testimonials__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Patron Reflections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Words From Our Community"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "Reflections from individuals embracing natural plant rituals into their daily rhythm."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Display star rating",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer quote",
          "default": "The subtle aroma and pure botanical texture bring a moment of deep grounding to my evening routine. You can feel the intention behind every bottle."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Elena R."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Author subtitle / location",
          "default": "Verified Patron • Portland, OR"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The gentle botanical purity of Aryvan has become an indispensable ritual for my morning meditation and quiet hours.",
            "author": "Marcus V.",
            "subtitle": "Botanical Wellness Member"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "You can immediately distinguish the artisan craft in these small-batch infusions. Clean, grounding, and completely natural.",
            "author": "Claire T.",
            "subtitle": "Verified Patron"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Packaging in amber glass and respecting whole-plant synergy makes Aryvan stand out in an industry crowded with synthetics.",
            "author": "Julian M.",
            "subtitle": "Herbalism Enthusiast"
          }
        }
      ]
    }
  ]
}
{% endschema %}
