<section
  id="brand-story"
  class="brand-story full-width brand-story--layout-{{ section.settings.image_position }} brand-story--bg-{{ section.settings.background_style }}"
>
  <div class="brand-story__container">
    <div class="brand-story__media-col">
      {% if section.settings.image != blank %}
        <div class="brand-story__image-wrap">
          {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'brand-story__image', loading: 'lazy' }}
        </div>
      {% else %}
        <div class="brand-story__illustration-wrap" aria-hidden="true">
          <svg viewBox="0 0 600 700" fill="none" xmlns="http://www.w3.org/2000/svg" class="brand-story__svg">
            <rect width="600" height="700" rx="16" fill="#EDE7DC"/>
            <path d="M300 120C340 240 420 300 480 340C380 360 340 440 300 560C260 440 220 360 120 340C180 300 260 240 300 120Z" fill="#5B6E5D" fill-opacity="0.25"/>
            <circle cx="300" cy="340" r="160" stroke="#C49A6C" stroke-width="1.5" stroke-dasharray="4 6" stroke-opacity="0.5"/>
            <path d="M300 180V500" stroke="#263629" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M300 240C330 220 370 230 380 260C350 265 320 250 300 240Z" fill="#263629" fill-opacity="0.7"/>
            <path d="M300 320C270 300 230 310 220 340C250 345 280 330 300 320Z" fill="#263629" fill-opacity="0.7"/>
            <path d="M300 400C330 380 370 390 380 420C350 425 320 410 300 400Z" fill="#263629" fill-opacity="0.7"/>
          </svg>
        </div>
      {% endif %}

      {% if section.settings.quote != blank %}
        <blockquote class="brand-story__quote-card">
          <p class="brand-story__quote-text">&ldquo;{{ section.settings.quote }}&rdquo;</p>
          {% if section.settings.quote_author != blank %}
            <cite class="brand-story__quote-author">— {{ section.settings.quote_author }}</cite>
          {% endif %}
        </blockquote>
      {% endif %}
    </div>

    <div class="brand-story__content-col">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="brand-story__body">
        {% if section.settings.text_paragraph_1 != blank %}
          <p>{{ section.settings.text_paragraph_1 }}</p>
        {% endif %}

        {% if section.settings.text_paragraph_2 != blank %}
          <p>{{ section.settings.text_paragraph_2 }}</p>
        {% endif %}
      </div>

      <div class="brand-story__pillars">
        <div class="brand-story__pillar-item">
          <span class="brand-story__pillar-number">01</span>
          <span class="brand-story__pillar-label">Ethically Foraged</span>
        </div>
        <div class="brand-story__pillar-item">
          <span class="brand-story__pillar-number">02</span>
          <span class="brand-story__pillar-label">Slow Botanical Infusion</span>
        </div>
        <div class="brand-story__pillar-item">
          <span class="brand-story__pillar-number">03</span>
          <span class="brand-story__pillar-label">Small-Batch Purity</span>
        </div>
      </div>

      {% if section.settings.button_label != blank %}
        <div class="brand-story__action">
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button button-primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-story {
    padding: 6rem 0;
  }

  .brand-story--bg-cream {
    background-color: var(--color-surface, #F4EFE6);
  }

  .brand-story--bg-ivory {
    background-color: var(--color-background, #FBF9F5);
  }

  .brand-story__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.5rem;
    align-items: center;
  }

  .brand-story--layout-right .brand-story__container {
    direction: rtl;
  }

  .brand-story--layout-right .brand-story__container > * {
    direction: ltr;
  }

  .brand-story__media-col {
    position: relative;
  }

  .brand-story__image-wrap,
  .brand-story__illustration-wrap {
    border-radius: var(--style-border-radius-cards, 12px);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: #EDE7DC;
    border: 1px solid var(--color-border, #E6E1D6);
  }

  .brand-story__image,
  .brand-story__svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-story__quote-card {
    position: absolute;
    bottom: -1.5rem;
    right: -1.5rem;
    background-color: var(--color-background, #FBF9F5);
    border: 1px solid var(--color-border, #E6E1D6);
    border-radius: var(--style-border-radius-cards, 8px);
    padding: 1.5rem 1.75rem;
    max-width: 320px;
    box-shadow: 0 16px 32px rgba(35, 46, 36, 0.08);
  }

  .brand-story__quote-text {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--color-primary, #263629);
    margin: 0 0 0.5rem;
  }

  .brand-story__quote-author {
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary, #5B6E5D);
    display: block;
  }

  .brand-story__content-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .brand-story__heading {
    margin: 0;
  }

  .brand-story__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-foreground, #232E24);
    opacity: 0.9;
  }

  .brand-story__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border, #E6E1D6);
    border-bottom: 1px solid var(--color-border, #E6E1D6);
    margin: 0.5rem 0;
  }

  .brand-story__pillar-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .brand-story__pillar-number {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    color: var(--color-accent, #C49A6C);
  }

  .brand-story__pillar-label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary, #263629);
  }

  .brand-story__action {
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .brand-story {
      padding: 4rem 0;
    }
    .brand-story__container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .brand-story__quote-card {
      position: static;
      margin-top: 1rem;
      max-width: 100%;
    }
    .brand-story__pillars {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background color",
      "options": [
        {
          "value": "cream",
          "label": "Warm Cream"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        }
      ],
      "default": "cream"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Rooted in Ancient Wisdom"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Philosophy of Living Botanicals"
    },
    {
      "type": "textarea",
      "id": "text_paragraph_1",
      "label": "First paragraph",
      "default": "At Aryvan, botanical wellness is not merely an extraction; it is a sacred dialogue with the earth. We honor the innate intelligence of whole plants, cultivating harmony between ancestral herbalism and contemporary botanical science."
    },
    {
      "type": "textarea",
      "id": "text_paragraph_2",
      "label": "Second paragraph",
      "default": "Every tincture, elixir, and balm is slow-steeped in small artisanal vessels, ensuring the living phytochemical matrix remains uncompromised and fully resonant."
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Callout quote",
      "default": "Nature does not hurry, yet everything is accomplished."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote attribution",
      "default": "Aryvan Botanical Ethos"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
