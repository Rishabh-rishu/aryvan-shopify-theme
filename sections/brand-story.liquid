<section
  id="brand-story"
  class="brand-story full-width brand-story--layout-{{ section.settings.image_position }} brand-story--bg-{{ section.settings.background_style }}"
>
  <div class="brand-story__container">
    <div class="brand-story__media-col">
      <div class="brand-story__media-wrap editorial-card">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'editorial-card__img', loading: 'lazy', alt: section.settings.heading | escape }}
        {% else %}
          <img
            src="{{ 'temp-brand-story.webp' | asset_url }}"
            alt="Artisanal apothecary studio with herbal extracts and amber glass containers"
            class="editorial-card__img"
            width="1200"
            height="1500"
            loading="lazy"
          >
        {% endif %}
      </div>

      {% if section.settings.quote != blank %}
        <blockquote class="brand-story__quote-card">
          <p class="brand-story__quote-text">&ldquo;{{ section.settings.quote }}&rdquo;</p>
          {% if section.settings.quote_author != blank %}
            <cite class="brand-story__quote-author">— {{ section.settings.quote_author }}</cite>
          {% endif %}
        </blockquote>
      {% endif %}
    </div>

    <div class="brand-story__content-col">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="brand-story__body">
        {% if section.settings.text_paragraph_1 != blank %}
          <p>{{ section.settings.text_paragraph_1 }}</p>
        {% endif %}

        {% if section.settings.text_paragraph_2 != blank %}
          <p>{{ section.settings.text_paragraph_2 }}</p>
        {% endif %}
      </div>

      <div class="brand-story__pillars">
        <div class="brand-story__pillar-item">
          <span class="brand-story__pillar-number">01</span>
          <span class="brand-story__pillar-label">Whole-Plant Synergy</span>
        </div>
        <div class="brand-story__pillar-item">
          <span class="brand-story__pillar-number">02</span>
          <span class="brand-story__pillar-label">Slow Ambient Infusion</span>
        </div>
        <div class="brand-story__pillar-item">
          <span class="brand-story__pillar-number">03</span>
          <span class="brand-story__pillar-label">Artisanal Purity</span>
        </div>
      </div>

      {% if section.settings.button_label != blank %}
        <div class="brand-story__action">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button-primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-story {
    padding: 7rem 0;
  }

  .brand-story--bg-cream {
    background-color: var(--color-surface, #F1EADF);
  }

  .brand-story--bg-ivory {
    background-color: var(--color-background, #F8F5EF);
  }

  .brand-story__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 5.5rem;
    align-items: center;
  }

  .brand-story--layout-right .brand-story__container {
    direction: rtl;
  }

  .brand-story--layout-right .brand-story__container > * {
    direction: ltr;
  }

  .brand-story__media-col {
    position: relative;
  }

  .brand-story__media-wrap {
    aspect-ratio: 4 / 5;
    border-radius: var(--style-border-radius-cards, 4px);
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(31, 48, 37, 0.08);
  }

  .brand-story__quote-card {
    position: absolute;
    bottom: -1.75rem;
    right: -1.75rem;
    background-color: var(--color-background, #F8F5EF);
    border: 1px solid var(--color-border, #E4DDD1);
    border-radius: var(--style-border-radius-cards, 4px);
    padding: 1.75rem 2rem;
    max-width: 340px;
    box-shadow: 0 18px 36px rgba(31, 48, 37, 0.1);
  }

  .brand-story__quote-text {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 1.18rem;
    line-height: 1.45;
    color: var(--color-primary, #1F3025);
    margin: 0 0 0.65rem;
  }

  .brand-story__quote-author {
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-olive, #69775C);
    display: block;
  }

  .brand-story__content-col {
    display: flex;
    flex-direction: column;
    gap: 1.65rem;
  }

  .brand-story__heading {
    margin: 0;
  }

  .brand-story__body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-foreground, #292D29);
    opacity: 0.9;
  }

  .brand-story__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border, #E4DDD1);
    border-bottom: 1px solid var(--color-border, #E4DDD1);
    margin: 0.75rem 0;
  }

  .brand-story__pillar-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .brand-story__pillar-number {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.45rem;
    color: var(--color-accent, #C7A77A);
    line-height: 1;
  }

  .brand-story__pillar-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary, #1F3025);
  }

  .brand-story__action {
    margin-top: 0.5rem;
  }

  @media (max-width: 990px) {
    .brand-story {
      padding: 4.5rem 0;
    }
    .brand-story__container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .brand-story__quote-card {
      position: static;
      margin-top: 1.25rem;
      max-width: 100%;
    }
    .brand-story__pillars {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background color",
      "options": [
        { "value": "cream", "label": "Soft Cream" },
        { "value": "ivory", "label": "Warm Ivory" }
      ],
      "default": "ivory"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Rooted in Nature"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Nature. Refined by Intention."
    },
    {
      "type": "textarea",
      "id": "text_paragraph_1",
      "label": "First paragraph",
      "default": "At Aryvan, botanical wellness is rooted in reverence for the earth. We honor the innate complexity of living botanicals, bridging ancestral herbal traditions with meticulous modern craftsmanship."
    },
    {
      "type": "textarea",
      "id": "text_paragraph_2",
      "label": "Second paragraph",
      "default": "Each formulation is slow-macerated in small artisanal vessels, ensuring delicate volatile essences, terpenes, and plant sterols remain unadulterated and biologically resonant."
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Callout quote",
      "default": "True wellness is not created in haste. It is distilled through patience, reverence, and nature's quiet wisdom."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote attribution",
      "default": "Aryvan Botanical Ethos"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Our Philosophy"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
