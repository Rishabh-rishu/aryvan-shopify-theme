<section class="brand-intro full-width" aria-label="Brand Introduction">
  <div class="brand-intro__container">
    <div class="brand-intro__content">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow brand-intro__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="brand-intro__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="brand-intro__text">{{ section.settings.text }}</p>
      {% endif %}

      {% if section.settings.show_badges %}
        <div class="brand-intro__badges">
          <div class="brand-intro__badge">
            <span class="brand-intro__badge-dot"></span>
            <span>100% Pure Botanical Powders</span>
          </div>
          <div class="brand-intro__badge">
            <span class="brand-intro__badge-dot"></span>
            <span>Zero Synthetic Additives</span>
          </div>
          <div class="brand-intro__badge">
            <span class="brand-intro__badge-dot"></span>
            <span>Mindfully Sourced</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-intro {
    padding: 5.5rem 0 4.5rem;
    background-color: var(--color-background, #F8F5EF);
    text-align: center;
    position: relative;
  }

  .brand-intro__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .brand-intro__content {
    max-width: 820px;
    margin: 0 auto;
  }

  .brand-intro__eyebrow {
    color: var(--color-olive, #69775C);
    margin-bottom: 1rem;
  }

  .brand-intro__heading {
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1.2;
    color: var(--color-primary, #1F3025);
    margin-bottom: 1.5rem;
    letter-spacing: -0.015em;
  }

  .brand-intro__text {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-foreground, #292D29);
    opacity: 0.9;
    margin-bottom: 2.25rem;
  }

  .brand-intro__badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #E4DDD1);
  }

  .brand-intro__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #1F3025);
  }

  .brand-intro__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent, #C7A77A);
  }

  @media (max-width: 768px) {
    .brand-intro {
      padding: 3.5rem 0;
    }
    .brand-intro__badges {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "PLANT-BASED WELLNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Potent Whole-Plant Powders, Crafted with Reverence"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduction text",
      "default": "At Aryvan, we specialize in pure, unadulterated botanical powders and natural wellness ingredients. Guided by ancestral wisdom and refined with mindful intention, each harvest is dedicated to restorative daily living."
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show quality highlights",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Brand introduction"
    }
  ]
}
{% endschema %}
