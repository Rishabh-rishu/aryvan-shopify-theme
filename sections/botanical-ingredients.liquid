<section class="botanical-ingredients full-width">
  <div class="botanical-ingredients__container">
    <div class="botanical-ingredients__hero-grid">
      <div class="botanical-ingredients__hero-media editorial-card">
        {% if section.settings.feature_image != blank %}
          {{ section.settings.feature_image | image_url: width: 1400 | image_tag: class: 'editorial-card__img', loading: 'lazy', alt: section.settings.heading | escape }}
        {% else %}
          <img
            src="{{ 'temp-botanical-ingredients.webp' | asset_url }}"
            alt="Close-up macro of fresh organic medicinal botanical foliage"
            class="editorial-card__img"
            width="1200"
            height="900"
            loading="lazy"
          >
        {% endif %}
        <div class="botanical-ingredients__hero-badge">
          <span class="botanical-ingredients__badge-tag">Living Phytochemicals</span>
        </div>
      </div>

      <div class="botanical-ingredients__header">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="botanical-ingredients__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="botanical-ingredients__subtext">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    </div>

    <div class="botanical-ingredients__grid">
      {% for block in section.blocks %}
        <div class="botanical-ingredients__card" {{ block.shopify_attributes }}>
          <div class="botanical-ingredients__icon-wrap">
            {% case block.settings.icon %}
              {% when 'droplet' %}
                {{ 'icon-droplet.svg' | inline_asset_content }}
              {% when 'sun' %}
                {{ 'icon-sun.svg' | inline_asset_content }}
              {% when 'shield' %}
                {{ 'icon-shield.svg' | inline_asset_content }}
              {% else %}
                {{ 'icon-leaf.svg' | inline_asset_content }}
            {% endcase %}
          </div>

          <span class="botanical-ingredients__number">0{{ forloop.index }}</span>

          <h3 class="botanical-ingredients__title">{{ block.settings.title }}</h3>

          <p class="botanical-ingredients__description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .botanical-ingredients {
    padding: 7rem 0;
    background-color: var(--color-bg-primary, #0B1510);
    border-top: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
  }

  .botanical-ingredients__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .botanical-ingredients__hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4.5rem;
    align-items: center;
    margin-bottom: 4.5rem;
  }

  .botanical-ingredients__hero-media {
    aspect-ratio: 16 / 10;
    border-radius: var(--style-border-radius-cards, 4px);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .botanical-ingredients__hero-badge {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background-color: rgba(8, 15, 11, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(201, 164, 106, 0.35);
    padding: 0.5rem 1rem;
    border-radius: 2px;
    z-index: 2;
  }

  .botanical-ingredients__badge-tag {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent, #C9A46A);
    font-weight: 600;
  }

  .botanical-ingredients__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .botanical-ingredients__heading {
    margin: 0;
    color: var(--color-text-primary, #F3EBDD);
  }

  .botanical-ingredients__subtext {
    font-size: 1.1rem;
    color: var(--color-text-secondary, #B8B5A9);
    opacity: 0.95;
    line-height: 1.7;
    margin: 0;
  }

  .botanical-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .botanical-ingredients__card {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: var(--style-border-radius-cards, 4px);
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s var(--ease-luxury), box-shadow 0.35s var(--ease-luxury), border-color 0.35s ease;
  }

  .botanical-ingredients__card:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 164, 106, 0.45);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  .botanical-ingredients__icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(201, 164, 106, 0.12);
    border: 1px solid rgba(201, 164, 106, 0.25);
    color: var(--color-accent, #C9A46A);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .botanical-ingredients__icon-wrap svg {
    width: 24px;
    height: 24px;
  }

  .botanical-ingredients__number {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    color: var(--color-accent, #C9A46A);
    opacity: 0.85;
  }

  .botanical-ingredients__title {
    font-size: 1.35rem;
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    color: var(--color-text-primary, #F3EBDD);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .botanical-ingredients__description {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #B8B5A9);
    opacity: 0.9;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .botanical-ingredients__hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .botanical-ingredients__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 680px) {
    .botanical-ingredients {
      padding: 4.5rem 0;
    }
    .botanical-ingredients__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botanical ingredients",
  "settings": [
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Botanical photography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "BOTANICAL EXCELLENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whole-Plant Science & Intentional Alchemy"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "We formulate exclusively with whole-plant botanicals, cold infusions, and biodynamic extracts to respect the living integrity of nature."
    }
  ],
  "blocks": [
    {
      "type": "ingredient_pillar",
      "name": "Principle Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Botanical Leaf" },
            { "value": "droplet", "label": "Herbal Droplet" },
            { "value": "sun", "label": "Solar Energy" },
            { "value": "shield", "label": "Purity & Shield" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar title",
          "default": "Whole-Plant Integrity"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Utilizing complete botanical aerials, leaves, and roots to preserve the full biological synergy of nature's phytochemical spectrum."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Botanical ingredients",
      "blocks": [
        {
          "type": "ingredient_pillar",
          "settings": {
            "icon": "leaf",
            "title": "Whole-Plant Integrity",
            "description": "Utilizing complete botanical aerials, leaves, and roots to preserve the full biological synergy of nature's phytochemical spectrum."
          }
        },
        {
          "type": "ingredient_pillar",
          "settings": {
            "icon": "droplet",
            "title": "Botanical Extraction",
            "description": "Gentle ambient and cold-oil maceration without extreme thermal degradation, keeping plant sterols and terpenes intact."
          }
        },
        {
          "type": "ingredient_pillar",
          "settings": {
            "icon": "sun",
            "title": "Thoughtful Formulation",
            "description": "Harmonious botanical blends composed with intentional ingredient ratios, completely free of synthetic carriers or phthalates."
          }
        },
        {
          "type": "ingredient_pillar",
          "settings": {
            "icon": "shield",
            "title": "Nature-Inspired Wellness",
            "description": "Grounded in botanical balance and sensory ritual to foster daily calm, skin vitality, and holistic nourishment."
          }
        }
      ]
    }
  ]
}
{% endschema %}
