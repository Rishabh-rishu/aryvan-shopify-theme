<section class="botanical-ingredients full-width">
  <div class="botanical-ingredients__container">
    <div class="botanical-ingredients__header">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="botanical-ingredients__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="botanical-ingredients__subtext">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="botanical-ingredients__grid">
      {% for block in section.blocks %}
        <div class="botanical-ingredients__card botanical-card" {{ block.shopify_attributes }}>
          <div class="botanical-ingredients__icon-wrap">
            {% case block.settings.icon %}
              {% when 'droplet' %}
                {{ 'icon-droplet.svg' | inline_asset_content }}
              {% when 'sun' %}
                {{ 'icon-sun.svg' | inline_asset_content }}
              {% when 'shield' %}
                {{ 'icon-shield.svg' | inline_asset_content }}
              {% else %}
                {{ 'icon-leaf.svg' | inline_asset_content }}
            {% endcase %}
          </div>

          {% if block.settings.tag != blank %}
            <span class="botanical-ingredients__tag">{{ block.settings.tag }}</span>
          {% endif %}

          <h3 class="botanical-ingredients__title">{{ block.settings.title }}</h3>

          <p class="botanical-ingredients__description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .botanical-ingredients {
    padding: 6rem 0;
    background-color: var(--color-background, #FBF9F5);
  }

  .botanical-ingredients__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .botanical-ingredients__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .botanical-ingredients__heading {
    margin-bottom: 0.75rem;
  }

  .botanical-ingredients__subtext {
    font-size: 1.05rem;
    color: var(--color-foreground, #232E24);
    opacity: 0.85;
    line-height: 1.6;
  }

  .botanical-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .botanical-ingredients__card {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    background-color: var(--color-surface, #F4EFE6);
  }

  .botanical-ingredients__icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: #E8EFE7;
    color: var(--color-primary, #263629);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .botanical-ingredients__icon-wrap svg {
    width: 26px;
    height: 26px;
  }

  .botanical-ingredients__tag {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-secondary, #5B6E5D);
    margin-bottom: 0.35rem;
  }

  .botanical-ingredients__title {
    font-size: 1.35rem;
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    color: var(--color-primary, #263629);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .botanical-ingredients__description {
    font-size: 0.95rem;
    color: var(--color-foreground, #232E24);
    opacity: 0.85;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .botanical-ingredients {
      padding: 3.5rem 0;
    }
    .botanical-ingredients__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botanical ingredients",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Therapeutic Alchemy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Botanical Ingredients & Natural Principles"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtext",
      "default": "We formulate exclusively with whole-plant botanicals, cold infusions, and biodynamic extracts to respect the living essence of nature."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Principle / Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Botanical Leaf" },
            { "value": "droplet", "label": "Herbal Droplet" },
            { "value": "sun", "label": "Solar Energy" },
            { "value": "shield", "label": "Purity & Shield" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Botanical / Origin tag",
          "default": "Regenerative Wildcraft"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cold-Infused Potency"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Slow solar and ambient infusions that preserve delicate volatile terpenes, plant sterols, and cellular vitality without heat damage."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Botanical ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "icon": "droplet",
            "tag": "Slow Solar Infusion",
            "title": "Cold-Pressed & Infused",
            "description": "Slow maceration preserves delicate enzymes, terpenes, and antioxidants without thermal degradation."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "leaf",
            "tag": "Phytochemical Synergy",
            "title": "Whole-Plant Integrity",
            "description": "We honor whole flowers, leaves, and roots rather than isolating single chemical compounds."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "sun",
            "tag": "Living Vitality",
            "title": "Harmonic Adaptogens",
            "description": "Time-honored botanical roots and herbs known for encouraging physiological balance and daily resilience."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "shield",
            "tag": "Pure Standard",
            "title": "Zero Synthetic Additives",
            "description": "100% free of artificial fragrances, petroleum fillers, phthalates, synthetic preservatives, and sulfates."
          }
        }
      ]
    }
  ]
}
{% endschema %}
