{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<section class="not-found-section full-width">
  <div class="not-found-section__container">
    <div class="not-found-section__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 0 1 10 10c0 5.25-3.5 8.5-8.5 9.5-1.5.3-3.5.5-4.5.5C4 22 2 19 2 12A10 10 0 0 1 12 2z"/>
        <path d="M7 12c1.5-2 3.5-3 5-3s3.5 1 5 3"/>
        <path d="M12 9v9"/>
      </svg>
    </div>
    <span class="eyebrow not-found-section__eyebrow">404 &mdash; PATHWAY NOT FOUND</span>
    <h1 class="not-found-section__title">{{ '404.title' | t | default: 'The Formulation You Seek Is Elsewhere' }}</h1>
    <p class="not-found-section__text">
      {{ '404.not_found' | t | default: 'The page or botanical blend you requested may have migrated or is currently resting in harvest.' }}
    </p>
    <div class="not-found-section__actions">
      <a href="{{ routes.all_products_collection_url }}" class="button button-primary">
        {{ '404.back_to_shopping' | t | default: 'Explore All Formulations' }}
      </a>
      <a href="{{ routes.root_url }}" class="button button-secondary">
        Return Home
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .not-found-section {
    padding: 7rem 0;
    background-color: var(--color-bg-primary, #0B1510);
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .not-found-section__container {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 var(--page-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .not-found-section__icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    color: var(--color-accent, #C9A46A);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
  }
  .not-found-section__eyebrow {
    margin-bottom: 0.75rem;
  }
  .not-found-section__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--color-text-primary, #F3EBDD);
    margin: 0 0 1.25rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .not-found-section__text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary, #B8B5A9);
    margin: 0 0 2.5rem;
  }
  .not-found-section__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
