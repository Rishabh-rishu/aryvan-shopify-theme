<header class="site-header full-width" role="banner">
  <div class="site-header__container">
    <div class="site-header__left">
      <button
        type="button"
        class="site-header__menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="MobileNav"
        onclick="document.getElementById('MobileNav').classList.toggle('is-open'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');"
      >
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>

      <nav class="site-header__desktop-nav" aria-label="Main Navigation">
        <ul class="site-header__menu-list">
          {% for link in section.settings.menu.links %}
            <li class="site-header__menu-item">
              <a href="{{ link.url }}" class="site-header__link {% if link.active %}site-header__link--active{% endif %}">
                {{ link.title }}
              </a>
            </li>
          {% else %}
            <li class="site-header__menu-item"><a href="{{ routes.root_url }}" class="site-header__link site-header__link--active">Home</a></li>
            <li class="site-header__menu-item"><a href="{{ routes.all_products_collection_url }}" class="site-header__link">Shop</a></li>
            <li class="site-header__menu-item"><a href="#brand-story" class="site-header__link">Our Philosophy</a></li>
            <li class="site-header__menu-item"><a href="#newsletter" class="site-header__link">Botanical Journal</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <div class="site-header__center">
      {% if section.settings.logo != blank %}
        <a href="{{ routes.root_url }}" class="site-header__logo-link">
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: 'site-header__logo', alt: shop.name }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="site-header__brand-link">
          <span class="site-header__brand-title">{{ shop.name }}</span>
          <span class="site-header__brand-subtitle">Botanical Wellness</span>
        </a>
      {% endif %}
    </div>

    <div class="site-header__right">
      <button
        type="button"
        class="site-header__icon-btn theme-toggle"
        aria-label="Switch to Dark Mode"
        title="Switch to Dark Mode"
        data-theme-toggle
      >
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
          {{ 'icon-moon.svg' | inline_asset_content }}
        </span>
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
          {{ 'icon-sun.svg' | inline_asset_content }}
        </span>
        <span class="theme-toggle__tooltip" role="tooltip">Switch to Dark Mode</span>
      </button>

      <details class="site-header__search-details">
        <summary class="site-header__icon-btn" aria-label="{{ 'search.title' | t | default: 'Search' }}">
          {{ 'icon-search.svg' | inline_asset_content }}
        </summary>
        <div class="site-header__search-dropdown">
          <form action="{{ routes.search_url }}" method="get" role="search" class="site-header__search-form">
            <input
              type="search"
              name="q"
              placeholder="{{ 'search.placeholder' | t | default: 'Search botanical formulations...' }}"
              aria-label="{{ 'search.title' | t | default: 'Search' }}"
              class="site-header__search-input"
            >
            <button type="submit" class="site-header__search-submit" aria-label="{{ 'search.submit' | t | default: 'Search' }}">
              {{ 'icon-search.svg' | inline_asset_content }}
            </button>
          </form>
        </div>
      </details>

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="site-header__icon-btn site-header__cart-btn" aria-label="{{ 'cart.title' | t | default: 'Cart' }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="site-header__cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>

  <div id="MobileNav" class="site-header__mobile-drawer" aria-hidden="true">
    <div class="site-header__mobile-header">
      <span class="site-header__brand-title">{{ shop.name }}</span>
      <div class="site-header__mobile-header-actions">
        <button
          type="button"
          class="site-header__icon-btn theme-toggle"
          aria-label="Switch to Dark Mode"
          title="Switch to Dark Mode"
          data-theme-toggle
        >
          <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
            {{ 'icon-moon.svg' | inline_asset_content }}
          </span>
          <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
            {{ 'icon-sun.svg' | inline_asset_content }}
          </span>
        </button>
        <button
          type="button"
          class="site-header__icon-btn"
          aria-label="Close navigation menu"
          onclick="document.getElementById('MobileNav').classList.remove('is-open');"
        >
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>
    </div>
    <ul class="site-header__mobile-menu">
      {% for link in section.settings.menu.links %}
        <li>
          <a href="{{ link.url }}" class="site-header__mobile-link">
            {{ link.title }}
          </a>
        </li>
      {% else %}
        <li><a href="{{ routes.root_url }}" class="site-header__mobile-link">Home</a></li>
        <li><a href="{{ routes.all_products_collection_url }}" class="site-header__mobile-link">Shop</a></li>
        <li><a href="#brand-story" class="site-header__mobile-link">Our Philosophy</a></li>
        <li><a href="#newsletter" class="site-header__mobile-link">Botanical Journal</a></li>
      {% endfor %}
    </ul>
    <div class="site-header__mobile-footer">
      <div class="site-header__mobile-theme-row">
        <span class="site-header__mobile-theme-label">Appearance</span>
        <button
          type="button"
          class="site-header__mobile-theme-btn theme-toggle"
          aria-label="Switch to Dark Mode"
          data-theme-toggle
        >
          <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
            {{ 'icon-moon.svg' | inline_asset_content }}
          </span>
          <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
            {{ 'icon-sun.svg' | inline_asset_content }}
          </span>
          <span class="theme-toggle__label-text">Light Mode</span>
        </button>
      </div>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="site-header__mobile-link">
          {{ 'customers.login.title' | t | default: 'Login' }}
        </a>
      {% endif %}
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    background-color: var(--color-bg-header, #080F0B);
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    position: sticky;
    top: 0;
    z-index: 35;
    transition: background-color 0.3s ease;
  }

  .site-header__container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1.35rem var(--page-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__left {
    display: flex;
    align-items: center;
    flex: 1 1 0%;
  }

  .site-header__menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-accent, #C9A46A);
    padding: 0.5rem;
  }

  .site-header__desktop-nav {
    display: flex;
  }

  .site-header__menu-list {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-header__link {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-primary, #F3EBDD);
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.25s ease;
  }

  .site-header__link:hover,
  .site-header__link--active {
    color: var(--color-accent, #C9A46A);
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1px;
    background-color: var(--color-accent, #C9A46A);
    transition: width 0.35s var(--ease-luxury, ease);
  }

  .site-header__link:hover::after,
  .site-header__link--active::after {
    width: 100%;
  }

  .site-header__center {
    display: flex;
    justify-content: center;
    text-align: center;
    flex: 0 0 auto;
  }

  .site-header__brand-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-header__brand-title {
    font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.85rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--color-accent, #C9A46A);
    line-height: 1.1;
  }

  .site-header__brand-subtitle {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-primary, #F3EBDD);
    opacity: 0.85;
    margin-top: 0.25rem;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.35rem;
    flex: 1 1 0%;
  }

  .site-header__icon-btn {
    background: none;
    border: none;
    color: var(--color-accent, #C9A46A);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0.4rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .site-header__icon-btn:hover {
    color: var(--color-accent-hover, #D9B982);
    transform: translateY(-1px);
  }

  .site-header__icon-btn svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .site-header__cart-btn {
    position: relative;
  }

  .site-header__cart-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    background-color: var(--color-bg-card, #18271F);
    color: var(--color-accent, #C9A46A);
    border: 1px solid var(--color-accent, #C9A46A);
    font-size: 0.65rem;
    font-weight: 600;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .site-header__search-details {
    position: relative;
  }

  .site-header__search-details summary {
    list-style: none;
  }

  .site-header__search-details summary::-webkit-details-marker {
    display: none;
  }

  .site-header__search-dropdown {
    position: absolute;
    top: calc(100% + 0.85rem);
    right: 0;
    background-color: var(--color-bg-card, #18271F);
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    border-radius: var(--style-border-radius-inputs, 2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    padding: 0.85rem;
    min-width: 300px;
    z-index: 45;
  }

  .site-header__search-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .site-header__search-input {
    flex: 1;
    border: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    outline: none;
    background: var(--color-bg-secondary, #122019);
    color: var(--color-text-primary, #F3EBDD);
  }

  .site-header__search-input::placeholder {
    color: var(--color-text-muted, #8E968B);
  }

  .site-header__search-submit {
    background: var(--color-accent, #C9A46A);
    color: #080F0B;
    border: none;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    border-radius: var(--style-border-radius-inputs, 2px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .site-header__search-submit:hover {
    background: var(--color-accent-hover, #D9B982);
  }

  .site-header__search-submit svg {
    width: 1rem;
    height: 1rem;
  }

  .site-header__mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 82%;
    max-width: 350px;
    height: 100vh;
    background-color: var(--color-bg-header, #080F0B);
    border-right: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    box-shadow: 12px 0 35px rgba(0, 0, 0, 0.6);
    z-index: 100;
    flex-direction: column;
    padding: 1.75rem;
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-luxury);
  }

  .site-header__mobile-drawer.is-open {
    transform: translateX(0);
    display: flex;
  }

  .site-header__mobile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .site-header__mobile-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .site-header__mobile-link {
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-primary, #F3EBDD);
    transition: color 0.2s ease;
  }

  .site-header__mobile-link:hover {
    color: var(--color-accent, #C9A46A);
  }

  .site-header__mobile-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border, rgba(201, 164, 106, 0.22));
    padding-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .site-header__desktop-nav {
      display: none;
    }
    .site-header__menu-toggle {
      display: inline-flex;
    }
  }

  /* Theme Toggle Icon & Button */
  .theme-toggle {
    position: relative;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0.45rem;
    color: var(--color-text-primary, #25352B);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent, #A18455);
    background-color: rgba(161, 132, 85, 0.12);
    transform: scale(1.06);
  }

  .theme-toggle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    transition: transform 0.35s var(--ease-luxury), opacity 0.35s ease;
  }

  .theme-toggle__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }

  /* In Light Mode: display moon, hide sun */
  :root[data-theme="light"] .theme-toggle__icon--moon,
  html[data-theme="light"] .theme-toggle__icon--moon,
  :root:not([data-theme="dark"]) .theme-toggle__icon--moon {
    display: inline-flex;
    opacity: 1;
    transform: rotate(0deg) scale(1);
    color: var(--color-text-primary, #25352B);
  }

  :root[data-theme="light"] .theme-toggle__icon--sun,
  html[data-theme="light"] .theme-toggle__icon--sun,
  :root:not([data-theme="dark"]) .theme-toggle__icon--sun {
    display: none;
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  /* In Dark Mode: display sun, hide moon */
  :root[data-theme="dark"] .theme-toggle__icon--sun,
  html[data-theme="dark"] .theme-toggle__icon--sun {
    display: inline-flex;
    opacity: 1;
    transform: rotate(0deg) scale(1);
    color: var(--color-accent, #C9A46A);
  }

  :root[data-theme="dark"] .theme-toggle__icon--moon,
  html[data-theme="dark"] .theme-toggle__icon--moon {
    display: none;
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  /* Tooltip */
  .theme-toggle__tooltip {
    position: absolute;
    top: calc(100% + 8px);
    right: 50%;
    transform: translateX(50%) translateY(4px);
    background-color: var(--color-bg-card, #FFFFFF);
    color: var(--color-text-primary, #25352B);
    border: 1px solid var(--color-border, #E5E1D8);
    box-shadow: 0 4px 16px var(--color-card-shadow, rgba(0, 0, 0, 0.15));
    padding: 0.35rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    white-space: nowrap;
    border-radius: 3px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    z-index: 50;
  }

  .theme-toggle:hover .theme-toggle__tooltip,
  .theme-toggle:focus-visible .theme-toggle__tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(50%) translateY(0);
  }

  /* Mobile theme styling */
  .site-header__mobile-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header__mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border, #E5E1D8);
  }

  .site-header__mobile-theme-label {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary, #6F766E);
  }

  .site-header__mobile-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.95rem;
    background-color: var(--color-bg-secondary, #F1EFE8);
    border: 1px solid var(--color-border, #E5E1D8);
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-primary, #25352B);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .site-header__mobile-theme-btn:hover {
    border-color: var(--color-accent, #A18455);
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    function getCurrentTheme() {
      return document.documentElement.getAttribute('data-theme') || 'light';
    }

    function syncThemeUI(theme) {
      var isDark = theme === 'dark';
      var nextLabel = isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode';
      var currentModeText = isDark ? 'Dark Mode' : 'Light Mode';

      document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {
        btn.setAttribute('aria-label', nextLabel);
        btn.setAttribute('title', nextLabel);
        var tooltip = btn.querySelector('.theme-toggle__tooltip');
        if (tooltip) tooltip.textContent = nextLabel;
        var labelText = btn.querySelector('.theme-toggle__label-text');
        if (labelText) labelText.textContent = currentModeText;
      });
    }

    function setTheme(theme) {
      document.body.classList.add('theme-transitioning');
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('aryvan-theme', theme);
      } catch (e) {}

      syncThemeUI(theme);

      setTimeout(function() {
        document.body.classList.remove('theme-transitioning');
      }, 400);

      document.dispatchEvent(new CustomEvent('aryvan:themechange', { detail: { theme: theme } }));
    }

    function initThemeToggles() {
      var currentTheme = getCurrentTheme();
      syncThemeUI(currentTheme);

      document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {
        if (btn._aryvanBound) return;
        btn._aryvanBound = true;
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var active = getCurrentTheme();
          var target = active === 'dark' ? 'light' : 'dark';
          setTheme(target);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeToggles);
    } else {
      initThemeToggles();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 320,
      "step": 10,
      "default": 160,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
